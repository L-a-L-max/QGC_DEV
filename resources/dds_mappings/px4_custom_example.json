{
  "vendor": "px4_custom",
  "version": "1.0.0",
  "description": "Example: custom PX4 topic mapping overlay. Copy this file to ~/.config/QGroundControl/dds_mappings/ and modify topic names to match your PX4 version. Topics defined here override the default mapping.",
  "base": "_default",
  "topics": [
    {
      "dds_topic": "/fmu/out/vehicle_attitude",
      "dds_type": "px4_msgs::msg::dds_::VehicleAttitude_",
      "fact_group": "vehicle",
      "description": "Example: attitude topic override (topic name may vary by PX4 version)",
      "fields": [
        {
          "dds_field": "q[0]",
          "fact_name": "roll",
          "transform": "quaternion_to_euler_roll"
        },
        {
          "dds_field": "q[0]",
          "fact_name": "pitch",
          "transform": "quaternion_to_euler_pitch"
        },
        {
          "dds_field": "q[0]",
          "fact_name": "heading",
          "transform": "quaternion_to_euler_yaw"
        }
      ]
    },
    {
      "dds_topic": "/fmu/out/battery_status_v1",
      "dds_type": "px4_msgs::msg::dds_::BatteryStatus_",
      "fact_group": "battery",
      "description": "Example: battery topic with _v1 suffix for PX4 v1.17+",
      "fields": [
        {
          "dds_field": "voltage_v",
          "fact_name": "voltage"
        },
        {
          "dds_field": "remaining",
          "fact_name": "percentRemaining",
          "scale": 100.0
        }
      ]
    }
  ]
}
