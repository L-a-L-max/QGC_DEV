// PX4 BatteryStatus message — IDL for CycloneDDS (simplified)
// Source: PX4-Autopilot/msg/versioned/BatteryStatus.msg

module px4_msgs {
module msg {
module dds_ {

struct BatteryStatus_ {
    unsigned long long timestamp;
    boolean connected;
    float voltage_v;
    float current_a;
    float current_average_a;
    float discharged_mah;
    float remaining;
    float scale;
    float time_remaining_s;
    float temperature;
    octet cell_count;
    octet source;
    octet priority;
    unsigned short capacity;
    unsigned short cycle_count;
    unsigned short average_time_to_empty;
    unsigned short manufacture_date;
    unsigned short state_of_health;
    unsigned short max_error;
    octet id;
    unsigned short interface_error;
    float voltage_cell_v[14];
    float max_cell_voltage_delta;
    boolean is_powering_off;
    boolean is_required;
    octet warning;
    octet mode;
    float faults;
    unsigned long custom_faults;
};

}; // dds_
}; // msg
}; // px4_msgs
