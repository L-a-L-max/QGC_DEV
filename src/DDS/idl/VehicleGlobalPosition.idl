// PX4 VehicleGlobalPosition message — IDL for CycloneDDS
// Source: PX4-Autopilot/msg/versioned/VehicleGlobalPosition.msg

module px4_msgs {
module msg {
module dds_ {

struct VehicleGlobalPosition_ {
    unsigned long long timestamp;
    unsigned long long timestamp_sample;
    double lat;
    double lon;
    float alt;
    float alt_ellipsoid;
    boolean lat_lon_valid;
    boolean alt_valid;
    float delta_alt;
    float delta_terrain;
    octet lat_lon_reset_counter;
    octet alt_reset_counter;
    octet terrain_reset_counter;
    float eph;
    float epv;
    float terrain_alt;
    boolean terrain_alt_valid;
    boolean dead_reckoning;
};

}; // dds_
}; // msg
}; // px4_msgs
