module px4_msgs {
module msg {

@topic
struct ManualControlSetpoint {
    unsigned long long timestamp;
    unsigned long long timestamp_sample;
    boolean valid;
    octet data_source;
    float roll;
    float pitch;
    float yaw;
    float throttle;
    float flaps;
    float aux1;
    float aux2;
    float aux3;
    float aux4;
    float aux5;
    float aux6;
    boolean sticks_moving;
    unsigned short buttons;
};

}; // msg
}; // px4_msgs
